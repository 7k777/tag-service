{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tags",
  "main": "./worker.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "tags.newkis.cc",
      "custom_domain": true
    }
  ]
}
